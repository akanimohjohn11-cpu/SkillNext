# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase Configuration (Required for production Supabase Auth, PostgreSQL & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Console Passcode (Set this in Settings -> Secrets or Vercel Environment Variables)
ADMIN_PASSCODE=
